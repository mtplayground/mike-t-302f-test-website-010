---
const currentYear = new Date().getFullYear();
const footerLinks = [
  { label: 'Features', href: '#features' },
  { label: 'Community', href: '#community' },
  { label: 'Contact', href: '#contact' },
];
---

<footer class="border-t border-claw-800 bg-claw-950">
  <div class="mx-auto max-w-content px-gutter py-section-sm">
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <a href="/" class="flex w-fit items-center gap-3 text-claw-50 no-underline" aria-label="myClawTeam home">
        <img
          src="/favicon.svg"
          alt=""
          width="36"
          height="36"
          class="h-9 w-9 shrink-0 rounded-panel border border-claw-700 bg-claw-900"
        />
        <span class="font-display text-lg font-semibold">myClawTeam</span>
      </a>

      <nav aria-label="Secondary navigation" class="flex flex-wrap gap-x-6 gap-y-3">
        {
          footerLinks.map((link) => (
            <a
              href={link.href}
              class="text-sm font-medium text-claw-200 no-underline transition-colors hover:text-ember-300"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="mt-10 flex min-w-0 flex-col gap-3 border-t border-claw-800 pt-6 text-sm text-claw-300 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {currentYear} myClawTeam. All rights reserved.</p>
      <p>Built with Astro and Tailwind CSS.</p>
    </div>
  </div>
</footer>

---
import FeatureCard from './FeatureCard.astro';
import { features } from '../data/features';
---

<section id="features" class="border-b border-claw-800 bg-claw-950 py-section" aria-labelledby="features-title">
  <div class="mx-auto max-w-content px-gutter">
    <div class="max-w-measure">
      <p class="text-sm font-semibold uppercase text-ember-300">Capabilities</p>
      <h2 id="features-title" class="mt-3 font-display text-3xl font-bold leading-tight text-claw-50 sm:text-4xl">
        Built for steady product execution
      </h2>
      <p class="mt-4 text-base leading-8 text-claw-200 sm:text-lg">
        myClawTeam keeps the workflow tight from scope to validation, with each capability reinforcing the next issue.
      </p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        features.map((feature) => (
          <FeatureCard icon={feature.icon} title={feature.title} description={feature.description} />
        ))
      }
    </div>
  </div>
</section>

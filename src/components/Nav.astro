---
const navLinks = [
  { label: 'Features', href: '#features' },
  { label: 'Community', href: '#community' },
  { label: 'Contact', href: '#contact' },
];
---

<header class="sticky top-0 z-50 border-b border-claw-800/80 bg-claw-950/85 backdrop-blur" data-mobile-nav>
  <nav
    aria-label="Primary navigation"
    class="mx-auto flex h-16 max-w-content items-center justify-between gap-4 px-gutter"
  >
    <a href="/" class="flex min-w-0 items-center gap-3 text-claw-50 no-underline" aria-label="myClawTeam home">
      <img
        src="/favicon.svg"
        alt=""
        width="36"
        height="36"
        class="h-9 w-9 shrink-0 rounded-panel border border-claw-700 bg-claw-900"
      />
      <span class="truncate font-display text-base font-semibold tracking-normal sm:text-lg">myClawTeam</span>
    </a>

    <div class="hidden items-center gap-8 md:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-claw-200 no-underline transition-colors hover:text-ember-300"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <a
      href="#contact"
      class="hidden h-10 shrink-0 items-center justify-center rounded-panel bg-ember-500 px-4 text-sm font-semibold text-claw-950 no-underline shadow-glow transition-colors hover:bg-ember-400 hover:text-claw-950 md:inline-flex"
    >
      Get Started
    </a>

    <button
      type="button"
      class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-panel border border-claw-700 bg-claw-900 text-claw-100 transition-colors hover:border-ember-400 hover:text-ember-300 md:hidden"
      aria-label="Toggle navigation"
      aria-controls="mobile-menu"
      aria-expanded="false"
      data-mobile-toggle
    >
      <span class="sr-only">Toggle navigation</span>
      <span class="flex w-5 flex-col gap-1.5" aria-hidden="true">
        <span class="h-0.5 w-full rounded-full bg-current"></span>
        <span class="h-0.5 w-full rounded-full bg-current"></span>
        <span class="h-0.5 w-full rounded-full bg-current"></span>
      </span>
    </button>
  </nav>

  <div id="mobile-menu" class="border-t border-claw-800 bg-claw-950 px-gutter py-4 md:hidden" data-mobile-menu hidden>
    <div class="mx-auto flex max-w-content flex-col gap-2">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-panel px-3 py-3 text-base font-medium text-claw-100 no-underline transition-colors hover:bg-claw-900 hover:text-ember-300"
            data-mobile-menu-link
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="#contact"
        class="mt-2 inline-flex h-11 items-center justify-center rounded-panel bg-ember-500 px-4 text-sm font-semibold text-claw-950 no-underline shadow-glow transition-colors hover:bg-ember-400 hover:text-claw-950"
        data-mobile-menu-link
      >
        Get Started
      </a>
    </div>
  </div>

  <script>
    const nav = document.querySelector('[data-mobile-nav]');
    const button = nav?.querySelector('[data-mobile-toggle]');
    const menu = nav?.querySelector('[data-mobile-menu]');
    const menuLinks = nav?.querySelectorAll('[data-mobile-menu-link]') ?? [];
    const desktopQuery = window.matchMedia('(min-width: 768px)');

    if (nav instanceof HTMLElement && button instanceof HTMLButtonElement && menu instanceof HTMLElement) {
      const setMenuOpen = (isOpen) => {
        button.setAttribute('aria-expanded', String(isOpen));
        menu.hidden = !isOpen;
      };

      button.addEventListener('click', () => {
        setMenuOpen(button.getAttribute('aria-expanded') !== 'true');
      });

      menuLinks.forEach((link) => {
        link.addEventListener('click', () => setMenuOpen(false));
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          setMenuOpen(false);
        }
      });

      document.addEventListener('click', (event) => {
        if (event.target instanceof Node && !nav.contains(event.target)) {
          setMenuOpen(false);
        }
      });

      desktopQuery.addEventListener('change', (event) => {
        if (event.matches) {
          setMenuOpen(false);
        }
      });
    }
  </script>
</header>

---
const navLinks = [
  { label: 'Features', href: '#features' },
  { label: 'Community', href: '#community' },
  { label: 'Contact', href: '#contact' },
];
---

<header class="sticky top-0 z-50 border-b border-claw-800/80 bg-claw-950/85 backdrop-blur">
  <nav
    aria-label="Primary navigation"
    class="mx-auto flex h-16 max-w-content items-center justify-between gap-4 px-gutter"
  >
    <a href="/" class="flex min-w-0 items-center gap-3 text-claw-50 no-underline" aria-label="myClawTeam home">
      <img
        src="/favicon.svg"
        alt=""
        width="36"
        height="36"
        class="h-9 w-9 shrink-0 rounded-panel border border-claw-700 bg-claw-900"
      />
      <span class="truncate font-display text-base font-semibold tracking-normal sm:text-lg">myClawTeam</span>
    </a>

    <div class="hidden items-center gap-8 md:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-claw-200 no-underline transition-colors hover:text-ember-300"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <a
      href="#contact"
      class="inline-flex h-10 shrink-0 items-center justify-center rounded-panel bg-ember-500 px-4 text-sm font-semibold text-claw-950 no-underline shadow-glow transition-colors hover:bg-ember-400 hover:text-claw-950"
    >
      Get Started
    </a>
  </nav>
</header>

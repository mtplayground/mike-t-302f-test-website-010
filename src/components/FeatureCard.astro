---
export interface Props {
  title: string;
  description: string;
  icon?: string;
}

const { title, description, icon } = Astro.props;
---

<article class="h-full rounded-panel border border-claw-800 bg-claw-900/70 p-6 shadow-glow">
  <div class="flex h-11 w-11 items-center justify-center rounded-panel bg-ember-500 text-sm font-bold text-claw-950">
    {
      icon ? (
        <span aria-hidden="true">{icon}</span>
      ) : (
        <slot name="icon">
          <span class="h-2.5 w-2.5 rounded-full bg-claw-950" aria-hidden="true"></span>
        </slot>
      )
    }
  </div>
  <h3 class="mt-5 font-display text-xl font-semibold leading-7 text-claw-50">{title}</h3>
  <p class="mt-3 text-sm leading-7 text-claw-200">{description}</p>
</article>

---
import { communityLinks } from '../data/community';
---

<section id="community" class="border-b border-claw-800 bg-claw-900/40 py-section" aria-labelledby="community-title">
  <div class="mx-auto max-w-content px-gutter">
    <div class="max-w-measure">
      <p class="text-sm font-semibold uppercase text-ember-300">Community</p>
      <h2 id="community-title" class="mt-3 font-display text-3xl font-bold leading-tight text-claw-50 sm:text-4xl">
        Connect where the work continues
      </h2>
      <p class="mt-4 text-base leading-8 text-claw-200 sm:text-lg">
        Join the myClawTeam community channels for updates, implementation notes, and product progress.
      </p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-2">
      {
        communityLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noreferrer"
            aria-label={`${link.cta} (opens in a new tab)`}
            class="group rounded-panel border border-claw-800 bg-claw-950/80 p-6 no-underline shadow-glow transition-colors hover:border-ember-500"
          >
            <div class="flex gap-4">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-panel bg-ember-500 text-sm font-bold text-claw-950">
                <span aria-hidden="true">{link.icon}</span>
              </div>
              <div>
                <h3 class="font-display text-xl font-semibold leading-7 text-claw-50">{link.title}</h3>
                <p class="mt-3 text-sm leading-7 text-claw-200">{link.description}</p>
                <span class="mt-5 inline-flex text-sm font-semibold text-ember-300 transition-colors group-hover:text-ember-200">
                  {link.cta}
                  <span aria-hidden="true">&nbsp;-&gt;</span>
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
